  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 13}
  m_Text: "重构思路\r\n1. 反编译原版 APK，恢复成 Unity 工程\r\n2. 在工程里改场景与文本，重新打包 APK\r\n3. 汉化界面与字库、解锁章节、重调飞行手感\r\n4. 灵体变身改为 999 次，改动全部可回退"
  m_OffsetZ: 0
  m_CharacterSize: 10
  m_LineSpacing: 1
  m_Anchor: 4
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 0
  m_FontStyle: 0
  m_RichText: 0
  m_Font: {fileID: 12800000, guid: 439d0404d7bbed54db25608ff68d667e, type: 2}
  m_Color:
    serializedVersion: 2
    rgba: 4294967295
